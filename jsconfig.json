{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/core/**/*.js",
    "src/services/**/*.js",
    "src/server/**/*.js",
    "src/ui/store.js",
    "src/components/offerModal/formSerializer.js",
    "server.js"
  ]
}
